@page "/events"
@layout DashboardLayout
@inject IApplicationNavigation AppNav
@inject IHttpClientFactory HttpClientFactory
@inject ILocalStorageService LocalStorageService
@inject NavigationManager Navigation

<PageTitle>Event - List</PageTitle>

<MudPaper Height="100%" Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent pb-20 pt-8">
	<MudContainer MaxWidth="MaxWidth.Large">
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
			<MudFab StartIcon="@Icons.Material.Filled.Refresh" DropShadow="false" OnClick="RefreshCardEvent" />
			<MudGrid Justify="Justify.FlexStart" Spacing="5">
				<MudItem xs="12" sm="6" md="4" lg="3">
					<MudPaper Elevation="0" Outlined="false" Class="mud-secondary" Width="100%" Height="385px">
						<MudCard Elevation="0" Outlined="true" Style="height: 380px">
							<MudCarousel Class="mud-width-full" Style="height:200px;" ShowArrows="false" ShowBullets="false" EnableSwipeGesture="true" AutoCycle="true" TData="object">
								<MudCarouselItem Transition="Transition.Slide">
									<MudStack Row="false" Reverse="false" Spacing="0" Justify="Justify.Center" AlignItems="AlignItems.Center" Style="height: 100%">
										<MudImage Elevation="0" ObjectFit="ObjectFit.ScaleDown" ObjectPosition="ObjectPosition.Center" Src="./assets/plus-icon.png"></MudImage>
									</MudStack>
								</MudCarouselItem>
							</MudCarousel>
							<MudCardContent Class="overflow-y-scroll overflow-x-hidden" Style="height: 10px">
								<MudText Typo="Typo.h5">Tambah Event Baru</MudText>
							</MudCardContent>
							<MudCardActions>
								<MudButton StartIcon="@Icons.Material.Filled.LibraryAdd" Variant="Variant.Text" Color="Color.Primary" OnClick="NewEventOpenDialog">Tambah</MudButton>
							</MudCardActions>
						</MudCard>
					</MudPaper>
				</MudItem>
				@foreach (CardEvent cardEvent in _cardEvents)
				{
					<MudItem xs="12" sm="6" md="4" lg="3">
						<MudPaper Elevation="0" Outlined="false" Class="mud-secondary" Width="100%" Height="385px">
							<MudCard Elevation="0" Outlined="true" Style="height: 380px">
								<MudCarousel Class="mud-width-full" Style="height:200px;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="true" AutoCycle="true" TData="object">
									@foreach (Poster poster in cardEvent.Posters)
									{
										<MudCarouselItem Transition="Transition.Slide">
											<MudStack Row="false" Reverse="false" Spacing="0" Justify="Justify.Center" AlignItems="AlignItems.Center" Style="height: 100%">
												<MudImage Elevation="0" ObjectFit="ObjectFit.Contain" ObjectPosition="ObjectPosition.Center" Height="200" Src="@poster.FullPathUrl"></MudImage>
											</MudStack>
										</MudCarouselItem>
									}
								</MudCarousel>
								<MudCardContent Class="overflow-y-scroll overflow-x-hidden" Style="height: 10px">
									<MudText Typo="Typo.h5" Style="word-break: break-word;">
										<b>@cardEvent.Title</b>
									</MudText>
									<MudText Typo="Typo.body2" Style="word-break: break-word;">
										@((MarkupString)cardEvent.Description)
									</MudText>
								</MudCardContent>
								<MudCardActions>
									<MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => EventOpen(cardEvent.EventId)">Open</MudButton>
									<MudSpacer />
									<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
										<ActivatorContent>
											<MudIcon Icon="@Icons.Material.Filled.MoreVert" @onclick="@context.ToggleAsync" />
										</ActivatorContent>
										<ChildContent>
											<MudMenuItem IconColor="Color.Info" Icon="@Icons.Material.Filled.Edit" Label="Edit" OnClick="() => EventEdit(cardEvent.EventId)" />
											<MudMenuItem IconColor="Color.Error" Icon="@Icons.Material.Filled.Delete" Label="Delete" OnClick="() => EventDelete(cardEvent.EventId)" />
										</ChildContent>
									</MudMenu>
								</MudCardActions>
							</MudCard>
						</MudPaper>
					</MudItem>
				}
			</MudGrid>
		</MudStack>
	</MudContainer>
</MudPaper>

<MudDialog @bind-Visible="_newEventDialogVisible" Options="_newEventDialogOptions">
	<TitleContent>
		<MudText Typo="Typo.h6">Tambah Acara</MudText>
	</TitleContent>
	<DialogContent>
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
			<MudCard Style="width: 100%;">
				<MudCardContent>
					<MudText Typo="Typo.h6">Nama Acara</MudText>
					<MudText Typo="Typo.body2">tulis nama acara / event disini</MudText>
					<MudTextField FullWidth="true" @bind-Value="_newEvent.Title" Label="" Variant="Variant.Text" Placeholder="...text here"></MudTextField>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Deskripsi Acara</MudText>
					<MudText Typo="Typo.body2">tulis deskripsi acara / event disini</MudText>
					<RichTextEditor @bind-Content="_newEvent.Description" ToolbarOptions="ToolbarOptions.FullToolbarOptions" Placeholder="...text here" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Upload Poster</MudText>
					<MudText Typo="Typo.body2">maksimal 5 gambar dan 5MB per gambar</MudText>
					<MudFileUpload T="IBrowserFile" FilesChanged="AddPoster" DragAndDrop="true" Accept=".png, .jpeg, .jpg, .webp" MaxFileSize="(1024 * 1024) * 5">
						<SelectedTemplate>
						</SelectedTemplate>
					</MudFileUpload>
					<MudChipSet Size="Size.Small" T="string" AllClosable="true" OnClose="@((chip) => RemovePoster(chip.Value))">
						@foreach (var file in _posterFiles)
						{
							<MudChip T=string Size="Size.Small" Value="file.Name" />
						}
					</MudChipSet>
				</MudCardContent>
			</MudCard>
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="NewEventCloseDialog" Class="px-10">Batal</MudButton>
		<MudButton Color="Color.Primary" OnClick="SubmitNewEventAsync" Class="px-10">Kirim</MudButton>
	</DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_editDialogOpen" Options="_editDialogOption">
	<TitleContent>
		<MudText Typo="Typo.h6">Edit Acara</MudText>
	</TitleContent>
	<DialogContent>
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
			<MudCard Style="width: 100%;">
				<MudCardContent>
					<MudText Typo="Typo.h6">Nama Acara</MudText>
					<MudText Typo="Typo.body2">tulis nama acara / event disini</MudText>
					<MudTextField FullWidth="true" @bind-Value="_eventDetail.Title" Label="" Variant="Variant.Text" Placeholder="...text here"></MudTextField>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Deskripsi Acara</MudText>
					<MudText Typo="Typo.body2">tulis deskripsi acara / event disini</MudText>
					<RichTextEditor @bind-Content="_eventDetail.Description" ToolbarOptions="ToolbarOptions.FullToolbarOptions" Placeholder="...text here" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Pesan</MudText>
					<MudText Typo="Typo.body2">tulis pesan untuk peserta yang baru menyelesaikan pendaftaran disini</MudText>
					<RichTextEditor @bind-Content="_eventDetail.AfterBuyDescription" ToolbarOptions="ToolbarOptions.FullToolbarOptions" Placeholder="...text here" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Akses Pendaftaran</MudText>
					<MudText Typo="Typo.body2">buka atau tutup pendaftaran untuk event ini</MudText>
					<MudSwitch @bind-Value="_eventDetail.IsRegistrationOpen" ThumbIcon="@(_eventDetail.IsRegistrationOpen == true ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)" ThumbIconColor="@(_eventDetail.IsRegistrationOpen == true ? Color.Success : Color.Error)">
						@(_eventDetail.IsRegistrationOpen ? "pendaftaran dibuka" : "pendaftaran ditutup")
					</MudSwitch>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Tanggal Buka</MudText>
					<MudText Typo="Typo.body2">atur tanggal pendaftaran mulai dibuka (tidak boleh lebih besar dari tanggal tutup)</MudText>
					<MudDatePicker @bind-Date="_dateOpenRegistration"
								   AdditionalDateClassesFunc="@((DateTime dt)=>((int)dt.DayOfWeek == 0 ? "red-text text-accent-3" : ""))" />
					<MudTimePicker @bind-Time="_timeOpenRegistration" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Tanggal Tutup</MudText>
					<MudText Typo="Typo.body2">atur tanggal pendaftaran mulai ditutup (tidak boleh lebih kecil dari tanggal buka)</MudText>
					<MudDatePicker @bind-Date="_dateCloseRegistration"
								   AdditionalDateClassesFunc="@((DateTime dt)=>((int)dt.DayOfWeek == 0 ? "red-text text-accent-3" : ""))" />
					<MudTimePicker @bind-Time="_timeCloseRegistration" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Update Poster</MudText>
					<MudText Typo="Typo.body2">maksimal 5 gambar dan 5MB per gambar</MudText>
					<MudFileUpload T="IBrowserFile" FilesChanged="EditEventAddPoster" DragAndDrop="true" Accept=".png, .jpeg, .jpg, .webp" MaxFileSize="(1024 * 1024) * 5">
						<SelectedTemplate>
						</SelectedTemplate>
					</MudFileUpload>
					<MudChipSet Size="Size.Small" T="string" AllClosable="true" OnClose="@((chip) => EditEventRemovePoster(chip.Value))">
						@foreach (var file in _editEventPosterFiles)
						{
							<MudChip T=string Size="Size.Small" Value="file.Name" />
						}
					</MudChipSet>
				</MudCardContent>
			</MudCard>
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="() => { _editDialogOpen = false; }" Class="px-10">Batal</MudButton>
		<MudButton Color="Color.Primary" OnClick="async () => { await SubmitEventEdit(_eventDetail.EventId.ToString()); }" Class="px-10">Kirim</MudButton>
	</DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_eventDeleteDialogVisible" Options="new()">
	<TitleContent>
		<MudText Typo="Typo.h6">⚠️ Tindakan Beresiko</MudText>
	</TitleContent>
	<DialogContent>
		<MudText>Menghapus event membuat anda tidak bisa mengakses dashboard event, tidak bisa scan tiket peserta dan tidak bisa mencairkan uang dari tiket</MudText>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="CancelDelete" Color="Color.Primary">Batal</MudButton>
		<MudButton Color="Color.Error" OnClick="ConfirmDelete">Tetap Hapus</MudButton>
	</DialogActions>
</MudDialog>

<MudOverlay Visible="_overlayVisible" Style="height: 100dvh" DarkBackground="true" Absolute="true" ZIndex="5000">
	<MudProgressCircular Color="Color.Primary" Indeterminate="true" />
</MudOverlay>

@code {
	private DateTime _jwtExpiredTime = DateTime.MinValue + TimeSpan.FromHours(1);
	private List<CardEvent> _cardEvents = [];
	private bool _overlayVisible = false;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		_overlayVisible = true;
		_cardEvents = await LoadCardEventListAsync();
		_overlayVisible = false;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			if (!await IsUserAuthenticated())
			{
				await ChallengeUnAuthenticatedAsync();
				return;
			}
		}

		if ((_jwtExpiredTime - TimeSpan.FromMinutes(1)) < DateTime.UtcNow)
		{
			if (!await IsUserAuthenticated())
			{
				await ChallengeUnAuthenticatedAsync();
				return;
			}
		}
	}

	#region edit event
	private bool _editDialogOpen = false;
	private readonly DialogOptions _editDialogOption = new();
	private List<IBrowserFile> _editEventPosterFiles = [];
	private EventDetail _eventDetail = new();
	private TimeSpan? _timeOpenRegistration = new TimeSpan(00, 00, 00);
	private DateTime? _dateOpenRegistration = DateTime.UtcNow;
	private TimeSpan? _timeCloseRegistration = new TimeSpan(00, 00, 00);
	private DateTime? _dateCloseRegistration = DateTime.UtcNow;

	private void EditEventRemovePoster(string? fileName)
	{
		IBrowserFile? removeFile = _editEventPosterFiles.Find(file => file.Name == fileName);
		if (removeFile is null)
			return;

		_editEventPosterFiles.Remove(removeFile);
	}

	private void EditEventAddPoster(IBrowserFile? file)
	{
		if (file is null)
			return;

		_editEventPosterFiles.Add(file);
		if (_editEventPosterFiles.Count > 5)
			_editEventPosterFiles.RemoveAt(0);
	}

	private async Task EventEdit(string eventId)
	{
		_overlayVisible = true;
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		var client = HttpClientFactory.CreateClient("backend");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

		_editEventPosterFiles = [];
		_eventDetail = await client.GetFromJsonAsync<EventDetail>($"/api/event/{eventId}") ?? new EventDetail();
		_dateOpenRegistration = _eventDetail.OpenRegistrationDate;
		_timeOpenRegistration = _dateOpenRegistration.Value.TimeOfDay;
		_dateCloseRegistration = _eventDetail.CloseRegistrationDate;
		_timeCloseRegistration = _dateCloseRegistration.Value.TimeOfDay;

		_editDialogOpen = true;
		_overlayVisible = false;
	}

	private async Task SubmitEventEdit(string eventId)
	{
		_overlayVisible = true;

		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);
		client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

		List<string> posterIds = [];
		StringBuilder querstringPosterIds = new("?");
		foreach (var posterDetail in _eventDetail.Posters)
		{
			string fileName = posterDetail.FullPathUrl;
			fileName = fileName.Split('?')[1];
			fileName = fileName.Split('=')[1];
			using (HttpResponseMessage response = await client.DeleteAsync($"/api/file?fileName={fileName}")) { }
			posterIds.Add(posterDetail.PosterId.ToString());
			querstringPosterIds.Append($"posterIds={posterDetail.PosterId}&");
		}

		querstringPosterIds.Length--;
		if (querstringPosterIds.Length > 1)
			using (HttpResponseMessage response = await client.DeleteAsync("/api/poster/batch" + querstringPosterIds.ToString())) { }

		foreach (IBrowserFile browserFile in _editEventPosterFiles)
		{
			using (var multipartFormContent = new MultipartFormDataContent())
			using (Stream stream = browserFile.OpenReadStream((1024 * 1024) * 5))
			using (StreamContent streamContent = new StreamContent(stream))
			{
				streamContent.Headers.ContentType = new MediaTypeHeaderValue(browserFile.ContentType);
				multipartFormContent.Add(streamContent, "file", browserFile.Name);
				using (HttpResponseMessage response = await client.PostAsync("/api/file", multipartFormContent))
				{
					if (response.StatusCode == System.Net.HttpStatusCode.Created)
					{
						Poster posterResponse = (await response.Content.ReadFromJsonAsync<Poster>())!;
						using (StringContent stringContent = new StringContent(
						$$"""
						{
						  "eventId": "{{_eventDetail.EventId}}",
						  "fullPathUrl": "{{posterResponse.FullPathUrl}}",
						  "mimeType": "{{posterResponse.MimeType}}",
						  "byteLength": {{posterResponse.ByteLength}}
						}
						""", System.Text.Encoding.UTF8, "application/json"))
						{
							using (HttpResponseMessage responsePosterPost = await client.PostAsync("/api/poster", stringContent))
							{
								if (responsePosterPost.StatusCode == System.Net.HttpStatusCode.OK)
								{
								}
							}
						}
					}
					else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
					{
						StateHasChanged();
					}
				}
			}
		}

		byte[] byteTeksDescription = Encoding.UTF8.GetBytes(_eventDetail.Description);
		byte[] byteTeksAfterBuy = Encoding.UTF8.GetBytes(_eventDetail.AfterBuyDescription);
		byte[] byteTeksFormTemplate = Encoding.UTF8.GetBytes(_eventDetail.FormTemplate);
		_eventDetail.OpenRegistrationDate = (_dateOpenRegistration!.Value.Date + _timeOpenRegistration) ?? _eventDetail.OpenRegistrationDate;
		_eventDetail.CloseRegistrationDate = (_dateCloseRegistration!.Value.Date + _timeCloseRegistration) ?? _eventDetail.CloseRegistrationDate;

		PutEvent putEvent = new()
		{
			Title = _eventDetail.Title,
			Description = Convert.ToBase64String(byteTeksDescription),
			AfterBuyDescription = Convert.ToBase64String(byteTeksAfterBuy),
			FormTemplate = Convert.ToBase64String(byteTeksFormTemplate),
			IsRegistrationOpen = _eventDetail.IsRegistrationOpen,
			OpenRegistrationDate = _eventDetail.OpenRegistrationDate,
			CloseRegistrationDate = _eventDetail.CloseRegistrationDate,
			BankAccountNumber = _eventDetail.BankAccountNumber,
			BankAccountName = _eventDetail.BankAccountName,
			IsDeleted = _eventDetail.IsDeleted
		};
		using (HttpResponseMessage responsePosterPost = await client.PutAsJsonAsync<PutEvent>($"/api/event/{_eventDetail.EventId}", putEvent))
		{
			if (responsePosterPost.StatusCode == System.Net.HttpStatusCode.NoContent)
			{
			}
		}


		await RefreshCardEvent();
		_editEventPosterFiles = [];
		_eventDetail = new EventDetail();
		_editDialogOpen = false;
		_overlayVisible = false;
	}
	#endregion

	#region open or delete
	private bool _eventDeleteDialogVisible = false;
	private string _confirmDeleteEvent = string.Empty;

	private void ConfirmDelete()
	{
		_confirmDeleteEvent = "delete";
	}

	private void CancelDelete()
	{
		_confirmDeleteEvent = "cancel";
	}

	private async Task EventDelete(string eventId)
	{
		_eventDeleteDialogVisible = true;

		while (true)
		{
			if (_confirmDeleteEvent == "delete")
			{
				_eventDeleteDialogVisible = false;
				_confirmDeleteEvent = string.Empty;
				break;
			}
			if (_confirmDeleteEvent == "cancel")
			{
				_eventDeleteDialogVisible = false;
				_confirmDeleteEvent = string.Empty;
				return;
			}
			await Task.Delay(1000);
		}
		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

		using (HttpResponseMessage response = await client.DeleteAsync($"/api/event?eventId={eventId}"))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
			{
				await RefreshCardEvent();
			}
		}
	}

	private async Task EventOpen(string eventId)
	{
		AppNav.NavigateToDashboard(eventId);
	}
	#endregion

	#region New Event Dialog
	private readonly DialogOptions _newEventDialogOptions = new();
	private bool _newEventDialogVisible = false;

	private CardEvent _newEvent = new();
	private List<IBrowserFile> _posterFiles = [];

	private void RemovePoster(string? fileName)
	{
		IBrowserFile? removeFile = _posterFiles.Find(file => file.Name == fileName);
		if (removeFile is null)
			return;

		_posterFiles.Remove(removeFile);
	}

	private void AddPoster(IBrowserFile? file)
	{
		if (file is null)
			return;

		_posterFiles.Add(file);
		if (_posterFiles.Count > 5)
			_posterFiles.RemoveAt(0);
	}

	private void NewEventOpenDialog() => _newEventDialogVisible = true;

	private void NewEventCloseDialog() => _newEventDialogVisible = false;

	private async Task SubmitNewEventAsync()
	{
		_overlayVisible = true;
		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);
		client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

		foreach (IBrowserFile browserFile in _posterFiles)
		{
			using (var multipartFormContent = new MultipartFormDataContent())
			using (Stream stream = browserFile.OpenReadStream((1024 * 1024) * 5))
			using (StreamContent streamContent = new StreamContent(stream))
			{
				streamContent.Headers.ContentType = new MediaTypeHeaderValue(browserFile.ContentType);
				multipartFormContent.Add(streamContent, "file", browserFile.Name);
				using (HttpResponseMessage response = await client.PostAsync("/api/file", multipartFormContent))
				{
					if (response.StatusCode == System.Net.HttpStatusCode.Created)
					{
						Poster posterResponse = (await response.Content.ReadFromJsonAsync<Poster>())!;
						_newEvent.Posters.Add(posterResponse);
					}
					else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
					{
						StateHasChanged();
					}
				}
			}
		}

		byte[] byteTeks = Encoding.UTF8.GetBytes(_newEvent.Description);
		_newEvent.Description = Convert.ToBase64String(byteTeks);

		string jsonPoster = JsonSerializer.Serialize<List<Poster>>(_newEvent.Posters);
		using (StringContent stringContent = new StringContent(
		$$"""
		{
		  "title": "{{_newEvent.Title}}",
		  "description": "{{_newEvent.Description}}",
		  "posters": {{jsonPoster}}
		}
		""", System.Text.Encoding.UTF8, "application/json"))
		{
			using (HttpResponseMessage response = await client.PostAsync("/api/event", stringContent))
			{
				if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
				{
					_posterFiles = [];
					_newEvent = new CardEvent();
				}
			}
		}

		_overlayVisible = false;
		_newEventDialogVisible = false;
		await RefreshCardEvent();
	}
	#endregion

	#region event list
	private async Task RefreshCardEvent() => _cardEvents = await LoadCardEventListAsync();

	private async Task<List<CardEvent>> LoadCardEventListAsync()
	{
		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);
		client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

		using (HttpResponseMessage response = await client.GetAsync("/api/event"))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.OK)
			{
				return await response.Content.ReadFromJsonAsync<List<CardEvent>>() ?? [];
			}
		}

		return [];
	}
	#endregion

	#region support class or record
	public class CardEvent
	{
		public string EventId { get; set; } = string.Empty;
		public string Title { get; set; } = string.Empty;
		public string Description { get; set; } = string.Empty;
		public List<Poster> Posters { get; set; } = [];
	}

	public class Poster
	{
		public string FullPathUrl { get; set; } = string.Empty;
		public string MimeType { get; set; } = string.Empty;
		public ulong ByteLength { get; set; }
	}

	public class EventDetail
	{
		public Guid EventId { get; set; }
