@page "/ticket/edit"
@layout DashboardLayout
@inject IApplicationNavigation AppNav
@inject ILocalStorageService LocalStorageService
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Ticket - Edit</PageTitle>

<MudPaper Height="100%" Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent pb-20 pt-8">
	<MudContainer MaxWidth="MaxWidth.Large">
		<MudTable Items="@_tickets" Hover="true" FixedHeader="true" Height="400px" PagerPosition="PagerPosition.Bottom">
			<ToolBarContent>
				<MudButton StartIcon="@Icons.Material.Filled.LibraryAdd" Variant="Variant.Text" Color="Color.Primary" OnClick="OpenDialogAddTicket">Tiket Baru</MudButton>
				<MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Text" OnClick="LoadTicketsAsync"></MudButton>
			</ToolBarContent>
			<HeaderContent>
				<MudTh>Id</MudTh>
				<MudTh>Nama Tiket</MudTh>
				<MudTh>Harga Satuan</MudTh>
				<MudTh>Total Kuota</MudTh>
				<MudTh>Kuota Terjual</MudTh>
				<MudTh>Status</MudTh>
				<MudTh>Tanggal buka</MudTh>
				<MudTh>Tanggal tutup</MudTh>
				<MudTh>Edit</MudTh>
				<MudTh>Delete</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="Id">
					<MudText Typo="Typo.body2">@context.TicketId.ToString().Split('-')[0]</MudText>
				</MudTd>
				<MudTd DataLabel="Nama Tiket">
					<MudText Typo="Typo.body2">@context.Category</MudText>
				</MudTd>
				<MudTd DataLabel="Harga Satuan">
					<MudText Typo="Typo.body2">@context.PriceOne.ToString("C0", new CultureInfo("id-ID"))</MudText>
				</MudTd>
				<MudTd DataLabel="Total Kuota">
					<MudText Typo="Typo.body2">@context.Quota</MudText>
				</MudTd>
				<MudTd DataLabel="Kuota Terjual">
					<MudText Typo="Typo.body2">@context.BookedQuota</MudText>
				</MudTd>
				<MudTd DataLabel="Status">
					<MudText Color="@(context.IsSalesOpen ? Color.Info : Color.Error)" Typo="Typo.body2">@(context.IsSalesOpen ? "dibuka" : "ditutup")</MudText>
				</MudTd>
				<MudTd DataLabel="Tanggal buka">
					<MudText Typo="Typo.body2">@context.OpenSalesDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
				</MudTd>
				<MudTd DataLabel="Tanggal tutup">
					<MudText Typo="Typo.body2">@context.CloseSalesDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
				</MudTd>
				<MudTd DataLabel="Edit">
					<MudButton StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Text" Color="Color.Primary" OnClick="() => OpenDialogEditTicketAsync(context.TicketId)">Edit</MudButton>
				</MudTd>
				<MudTd DataLabel="Delete">
					<MudButton StartIcon="@Icons.Material.Filled.Delete" Variant="Variant.Text" Color="Color.Secondary" OnClick="() => OpenDialogDeleteTicket(context.TicketId)">Delete</MudButton>
				</MudTd>
			</RowTemplate>
			<PagerContent>
				<MudTablePager PageSizeOptions="new int[] { 1, 5, 10, 20, 30 }" />
			</PagerContent>
		</MudTable>
	</MudContainer>
</MudPaper>

<MudDialog @bind-Visible="_deleteTicketDialogVisible" Options="new()">
	<TitleContent>
		<MudText Typo="Typo.h6">⚠️ Tindakan Beresiko</MudText>
	</TitleContent>
	<DialogContent>
		<MudText>tiket yang sudah terlanjur dibeli peserta akan tetap ada dan bisa di scan</MudText>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="() => _deleteTicketDialogVisible = false" Color="Color.Primary">Batal</MudButton>
		<MudButton Color="Color.Error" OnClick="DeleteTicketAsync">Tetap Hapus</MudButton>
	</DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_addTicketDialogVisible" Options="new()">
	<TitleContent>
		<MudText Typo="Typo.h6">Edit Tiket</MudText>
	</TitleContent>
	<DialogContent>
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
			<MudCard Style="width: 100%;">
				<MudCardContent>
					<MudText Typo="Typo.h6">Nama Tiket</MudText>
					<MudText Typo="Typo.body2">tulis nama tiket / event disini</MudText>
					<MudTextField FullWidth="true" @bind-Value="_addTicket.Category" Label="" Variant="Variant.Text" Placeholder="...text here"></MudTextField>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Pesan</MudText>
					<MudText Typo="Typo.body2">tulis pesan pada tiket disini, pesan akan tampil di ticket peserta</MudText>
					<RichTextEditor @bind-Content="_addTicket.ParticipantNotice" ToolbarOptions="ToolbarOptions.FullToolbarOptions" Placeholder="...text here" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Harga</MudText>
					<MudText Typo="Typo.body2">tulis 0 jika ingin ticket gratis</MudText>
					<MudNumericField FullWidth="true" @bind-Value="_addTicket.PriceOne"></MudNumericField>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Kuota</MudText>
					<MudText Typo="Typo.body2">tentukan jumlah maksimal kuota tiket</MudText>
					<MudNumericField FullWidth="true" @bind-Value="_addTicket.Quota"></MudNumericField>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">akses tiket</MudText>
					<MudText Typo="Typo.body2">buka atau tutup tiket untuk event ini</MudText>
					<MudSwitch @bind-Value="_addTicket.IsSalesOpen" ThumbIcon="@(_addTicket.IsSalesOpen == true ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)" ThumbIconColor="@(_addTicket.IsSalesOpen == true ? Color.Info : Color.Error)">
						@(_addTicket.IsSalesOpen ? "dibuka" : "ditutup")
					</MudSwitch>
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Tanggal Buka</MudText>
					<MudText Typo="Typo.body2">atur tanggal tiket mulai dibuka (tidak boleh lebih besar dari tanggal tutup)</MudText>
					<MudDatePicker @bind-Date="_dateOpenTicketAdd"
								   IsDateDisabledFunc="(DateTime datetime) => (datetime < _eventDetail.OpenRegistrationDate || datetime > _eventDetail.CloseRegistrationDate)"
								   AdditionalDateClassesFunc="@((DateTime dt) => ((int)dt.DayOfWeek == 0 ? "red-text text-accent-3" : ""))" />
					<MudTimePicker @bind-Time="_timeOpenTicketAdd" />
				</MudCardContent>
			</MudCard>
			<MudCard Style="width: 100%">
				<MudCardContent>
					<MudText Typo="Typo.h6">Tanggal Tutup</MudText>
					<MudText Typo="Typo.body2">atur tanggal batas waktu tiket ditutup (tidak boleh lebih kecil dari tanggal buka)</MudText>
					<MudDatePicker @bind-Date="_dateCloseTicketAdd"
								   IsDateDisabledFunc="(DateTime datetime) => (datetime < _eventDetail.OpenRegistrationDate || datetime > _eventDetail.CloseRegistrationDate)"
								   AdditionalDateClassesFunc="@((DateTime dt)=>((int)dt.DayOfWeek == 0 ? "red-text text-accent-3" : ""))" />
					<MudTimePicker @bind-Time="_timeCloseTicketAdd" />
				</MudCardContent>
			</MudCard>
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="() => _addTicketDialogVisible = false" Color="Color.Primary">Batal</MudButton>
		<MudButton Color="Color.Error" OnClick="AddTicketAsync">Simpan</MudButton>
	</DialogActions>
</MudDialog>

