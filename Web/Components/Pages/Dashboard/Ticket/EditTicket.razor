<MudOverlay Visible="_loading" Style="height: 100dvh" DarkBackground="true" Absolute="true" ZIndex="5000">
	<MudProgressCircular Color="Color.Primary" Indeterminate="true" />
</MudOverlay>

@code {
	[Parameter]
	[SupplyParameterFromQuery(Name = "eventId")]
	public string? EventId { get; set; }

	private DateTime _jwtExpiredTime = DateTime.MinValue + TimeSpan.FromHours(1);
	private bool _loading = false;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		if (string.IsNullOrEmpty(EventId) || string.IsNullOrWhiteSpace(EventId))
			AppNav.NavigateToPage();

		await LoadTicketsAsync();
		await LoadEvent();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			if (!await IsUserAuthenticated())
			{
				await ChallengeUnAuthenticatedAsync();
				return;
			}
		}

		if ((_jwtExpiredTime - TimeSpan.FromMinutes(1)) < DateTime.UtcNow)
		{
			if (!await IsUserAuthenticated())
			{
				await ChallengeUnAuthenticatedAsync();
				return;
			}
		}
	}

	#region add ticket
	private bool _addTicketDialogVisible = false;
	private AddTicketCategory _addTicket = new();
	private TimeSpan? _timeOpenTicketAdd = new TimeSpan(00, 00, 00);
	private DateTime? _dateOpenTicketAdd = DateTime.UtcNow;
	private TimeSpan? _timeCloseTicketAdd = new TimeSpan(00, 00, 00);
	private DateTime? _dateCloseTicketAdd = DateTime.UtcNow;

	public void OpenDialogAddTicket()
	{
		_addTicketDialogVisible = true;
		_addTicket = new AddTicketCategory()
		{
			EventId = Guid.Parse(EventId!),
			Category = string.Empty,
			ParticipantNotice = string.Empty,
			PriceOne = 0,
			Quota = 0,
			BookedQuota = 0,
			IsSalesOpen = false,
			OpenSalesDate = DateTime.UtcNow,
			CloseSalesDate = DateTime.UtcNow + TimeSpan.FromMinutes(1)
		};

		_dateOpenTicketAdd = _addTicket.OpenSalesDate;
		_timeOpenTicketAdd = _dateOpenTicketAdd.Value.TimeOfDay;
		_dateCloseTicketAdd = _addTicket.CloseSalesDate;
		_timeCloseTicketAdd = _dateCloseTicketAdd.Value.TimeOfDay;
	}

	public async Task AddTicketAsync()
	{
		_loading = true;

		_addTicket.OpenSalesDate = (_dateOpenTicketAdd!.Value.Date + _timeOpenTicketAdd) ?? _addTicket.OpenSalesDate;
		_addTicket.CloseSalesDate = (_dateCloseTicketAdd!.Value.Date + _timeCloseTicketAdd) ?? _addTicket.CloseSalesDate;
		byte[] byteString = Encoding.UTF8.GetBytes(_addTicket.ParticipantNotice);
		_addTicket.ParticipantNotice = Convert.ToBase64String(byteString);

		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

		using (HttpResponseMessage response = await client.PostAsJsonAsync<AddTicketCategory>($"/api/ticket", _addTicket))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.OK)
			{
				await LoadTicketsAsync();
			}
			if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
			{
				ProblemDetails errorValue = await response.Content.ReadFromJsonAsync<ProblemDetails>() ?? new ProblemDetails();
				Snackbar.Add(errorValue.Errors[0].Reason, Severity.Warning);
			}
		}

		_loading = false;
		_addTicketDialogVisible = false;
	}
	#endregion

	#region delete ticket
	private bool _deleteTicketDialogVisible = false;
	private Guid _deleteTicketId;

	public void OpenDialogDeleteTicket(Guid ticketId)
	{
		_deleteTicketDialogVisible = true;
		_deleteTicketId = ticketId;
	}

	public async Task DeleteTicketAsync()
	{
		_loading = true;

		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

		using (HttpResponseMessage response = await client.DeleteAsync($"/api/ticket/{_deleteTicketId.ToString()}"))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
			{
				await LoadTicketsAsync();
			}
		}

		_loading = false;
		_deleteTicketDialogVisible = false;
	}
	#endregion

	#region edit ticket
	private bool _editTicketDialogVisible = false;
	private Guid _editTicketId;
	private EditTicketCategory _editTicket = new();
	private TimeSpan? _timeOpenTicket = new TimeSpan(00, 00, 00);
	private DateTime? _dateOpenTicket = DateTime.UtcNow;
	private TimeSpan? _timeCloseTicket = new TimeSpan(00, 00, 00);
	private DateTime? _dateCloseTicket = DateTime.UtcNow;

	public void OpenDialogEditTicketAsync(Guid ticketId)
	{
		_editTicketDialogVisible = true;
		_editTicketId = ticketId;
		_editTicket = _tickets
			.Where(ticket => ticket.TicketId == ticketId)
			.Select(ticket => new EditTicketCategory()
			{
				BookedQuota = ticket.BookedQuota,
				Category = ticket.Category,
				CloseSalesDate = ticket.CloseSalesDate,
				OpenSalesDate = ticket.OpenSalesDate,
				IsDeleted = ticket.IsDeleted,
				IsSalesOpen = ticket.IsSalesOpen,
				ParticipantNotice = ticket.ParticipantNotice,
				PriceOne = (int)ticket.PriceOne,
				Quota = ticket.Quota
			})
			.First();

		_dateOpenTicket = _editTicket.OpenSalesDate;
		_timeOpenTicket = _dateOpenTicket.Value.TimeOfDay;
		_dateCloseTicket = _editTicket.CloseSalesDate;
		_timeCloseTicket = _dateCloseTicket.Value.TimeOfDay;
	}

	public async Task EditTicketAsync()
	{
		_loading = true;

		_editTicket.OpenSalesDate = (_dateOpenTicket!.Value.Date + _timeOpenTicket) ?? _editTicket.OpenSalesDate;
		_editTicket.CloseSalesDate = (_dateCloseTicket!.Value.Date + _timeCloseTicket) ?? _editTicket.CloseSalesDate;
		byte[] byteString = Encoding.UTF8.GetBytes(_editTicket.ParticipantNotice);
		_editTicket.ParticipantNotice = Convert.ToBase64String(byteString);

		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

		using (HttpResponseMessage response = await client.PutAsJsonAsync<EditTicketCategory>($"/api/ticket/{_editTicketId}", _editTicket))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
			{
				await LoadTicketsAsync();
			}
			if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
			{
				ProblemDetails errorValue = await response.Content.ReadFromJsonAsync<ProblemDetails>() ?? new ProblemDetails();
				Snackbar.Add(errorValue.Errors[0].Reason, Severity.Warning);
			}
		}

		_loading = false;
		_editTicketDialogVisible = false;
	}
	#endregion

	#region event load
	public EventDetail _eventDetail = new();

	public async Task LoadEvent()
	{
		_loading = true;

		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		var client = HttpClientFactory.CreateClient("backend");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

		using (HttpResponseMessage response = await client.GetAsync($"/api/event/{EventId}"))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.OK)
			{
				_eventDetail = (await response.Content.ReadFromJsonAsync<EventDetail>())!;
			}
			else
			{
				ProblemDetails errorValue = await response.Content.ReadFromJsonAsync<ProblemDetails>() ?? new ProblemDetails();
				Snackbar.Add("failed load event" + errorValue.Errors[0].Reason, Severity.Error);
			}
		}

		_loading = false;
	}
	#endregion

	#region Load Ticket
	public List<TicketCategory> _tickets = [];

	public async Task LoadTicketsAsync()
	{
		_loading = true;

		HttpClient client = HttpClientFactory.CreateClient("backend");
		string? jwt = await LocalStorageService.GetItemAsync<string>("jwt");
		client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);
		client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

		using (HttpResponseMessage response = await client.GetAsync($"/api/ticket/{EventId}/dashboard"))
		{
			if (response.StatusCode == System.Net.HttpStatusCode.OK)
			{
				_tickets = (await response.Content.ReadFromJsonAsync<List<TicketCategory>>())!.Where(ticket => ticket.IsDeleted == false).ToList();
			}
			else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
			{
				AppNav.NavigateToPage();
				return;
			}
		}

		_loading = false;
	}
	#endregion

	#region support class and record
	public class TicketCategory
	{
		public Guid TicketId { get; set; }
		public Guid EventId { get; set; }
		public string Category { get; set; } = string.Empty;
		public string ParticipantNotice { get; set; } = string.Empty;
		public decimal PriceOne { get; set; }
		public int Quota { get; set; }
		public int BookedQuota { get; set; }
		public bool IsSalesOpen { get; set; }
		public DateTime OpenSalesDate { get; set; }
		public DateTime CloseSalesDate { get; set; }
		public bool IsDeleted { get; set; }
	}

	public class EditTicketCategory
	{
		public string Category { get; set; } = string.Empty;
		public string ParticipantNotice { get; set; } = string.Empty;
		public int PriceOne { get; set; }
		public int Quota { get; set; }
		public int BookedQuota { get; set; }
		public bool IsSalesOpen { get; set; }
		public DateTime OpenSalesDate { get; set; }
		public DateTime CloseSalesDate { get; set; }
		public bool IsDeleted { get; set; }
	}

	public class AddTicketCategory
	{
		public Guid EventId { get; set; }
		public string Category { get; set; } = string.Empty;
		public string ParticipantNotice { get; set; } = string.Empty;
		public int PriceOne { get; set; }
		public int Quota { get; set; }
		public int BookedQuota { get; set; }
		public bool IsSalesOpen { get; set; }
		public DateTime OpenSalesDate { get; set; }
		public DateTime CloseSalesDate { get; set; }
	}

	public class ProblemDetails
	{
		public virtual int Status { get; set; }
		public virtual string Title { get; set; } = string.Empty;
		public virtual string Detail { get; set; } = string.Empty;
		public virtual string Instance { get; set; } = string.Empty;
		public virtual Uri Type { get; set; } = new Uri("about:blank");
		public virtual string TraceId { get; set; } = string.Empty;
		public virtual Error[] Errors { get; set; } = [];
	}

	public class Error
	{
		public virtual string Name { get; set; } = string.Empty;
		public virtual string Reason { get; set; } = string.Empty;
		public virtual string Code { get; set; } = string.Empty;
		public virtual string Severity { get; set; } = string.Empty;
	}

	public class EventDetail
	{
		public Guid EventId { get; set; }
		public Guid AcyouUserId { get; set; }
