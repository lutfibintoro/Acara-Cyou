@page "/"
@layout MainLayout

<PageTitle>Home</PageTitle>

<MudPaper Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent py-15">
	<MudContainer MaxWidth="MaxWidth.Small">
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center">
			<MudText Color="Color.Primary" Typo="Typo.overline" Align="Align.Center">EVENT & ACARA</MudText>
			<MudText Typo="Typo.h4" Align="Align.Center"><b>Buat Form Pendaftaran dengan <MudText Typo="Typo.h4" Color="Color.Primary" Inline="true"><b>E-Tiket</b></MudText> dan <MudText Typo="Typo.h4" Color="Color.Secondary" Inline="true"><b>Check-in</b></MudText> Otomatis</b></MudText>
			<MudText Typo="Typo.body2" Align="Align.Center">Atur waktu pendaftaran dan kuota tiket, kirim e-tiket otomatis ke email peserta, beri pesan custom ke e-tiket sesuai dengan ketentuan Anda, dan kelola check-in peserta saat hari-H dengan mudah.</MudText>
			<MudFab Color="Color.Secondary"
					StartIcon="@Icons.Material.Filled.ArrowOutward"
					Label="Buat Sekarang"
					Variant="Variant.Filled"
					Size="Size.Large"
					DropShadow="false"
					OnClick="NavigateToEvents" />
		</MudStack>
	</MudContainer>
</MudPaper>

<MudPaper Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent py-15">
	<MudContainer MaxWidth="MaxWidth.Large">
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
			<MudText Color="Color.Secondary" Typo="Typo.overline" Align="Align.Center">CARA KERJA</MudText>
			<MudText Typo="Typo.h4" Align="Align.Center" Class="pb-8"><b>Mulai dalam 3 langkah mudah</b></MudText>
			<MudGrid Justify="Justify.Center" Spacing="5">
				<MudItem xs="12" sm="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Color="Color.Primary">1</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Buat dan publikasi form</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Tentukan jenis tiket, harga, kuota, dan periode pendaftaran acara Anda.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Color="Color.Primary">2</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>E-tiket terkirim otomatis</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Peserta langsung menerima e-tiket melalui email dengan QR code setelah membayar biaya daftar.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Color="Color.Primary">3</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Check-in saat hari-H</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Pindai QR code untuk check-in peserta dengan cepat dan tanpa antre.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
			</MudGrid>
		</MudStack>
	</MudContainer>
</MudPaper>

<MudPaper Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent py-15">
	<MudContainer MaxWidth="MaxWidth.Large">
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
			<MudText id="fitur" Color="Color.Primary" Typo="Typo.overline" Align="Align.Center">FITUR UTAMA</MudText>
			<MudText Typo="Typo.h4" Align="Align.Center"><b>Kelola acara dari penjualan sampai pintu masuk</b></MudText>
			<MudText Typo="Typo.body2" Align="Align.Center" Class="pb-8">Semua kebutuhan ticketing dalam satu platform.</MudText>
			<MudGrid Justify="Justify.Center" Spacing="5">
				<MudItem xs="12" sm="6" md="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Rounded="true" Style="background-color: rgba(var(--mud-palette-primary-rgb), 0.1)">
								<MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" Color="Color.Primary" />
							</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>E-tiket otomatis</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Tiket ber-QR dikirim otomatis ke email pendaftar setelah pembayaran.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="6" md="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Rounded="true" Style="background-color: rgba(var(--mud-palette-secondary-rgb), 0.1)">
								<MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner" Color="Color.Secondary" />
							</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Sistem check-in</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Pindai QR code untuk verifikasi dan check-in peserta saat acara.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="6" md="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Rounded="true" Style="background-color: rgba(var(--mud-palette-primary-rgb), 0.1)">
								<MudIcon Icon="@Icons.Material.Outlined.Create" Color="Color.Primary" />
							</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Isi e-tiket custom</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Sesuaikan isi e-tiket dengan aturan, brand dan tema acara Anda.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="6" md="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Rounded="true" Style="background-color: rgba(var(--mud-palette-secondary-rgb), 0.1)">
								<MudIcon Icon="@Icons.Material.Outlined.AccessAlarms" Color="Color.Secondary" />
							</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Kuota dan waktu penjualan</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Batasi jumlah tiket dan atur kapan penjualan dibuka dan ditutup.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="6" md="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Rounded="true" Style="background-color: rgba(var(--mud-palette-primary-rgb), 0.1)">
								<MudIcon Icon="@Icons.Material.Outlined.LocalOffer" Color="Color.Primary" />
							</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Beragam jenis tiket</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Buat kategori tiket seperti Reguler, VIP, atau Early Bird.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
				<MudItem xs="12" sm="6" md="4" Class="d-flex">
					<MudPaper Elevation="0" Outlined="true" Class="flex-1 shades transparent pa-6">
						<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start">
							<MudAvatar Rounded="true" Style="background-color: rgba(var(--mud-palette-secondary-rgb), 0.1)">
								<MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" Color="Color.Secondary" />
							</MudAvatar>
							<MudText Typo="Typo.h6" Align="Align.Start"><b>Data peserta</b></MudText>
							<MudText Typo="Typo.body2" Align="Align.Start">Kumpulkan dan kelola data peserta untuk kebutuhan acara.</MudText>
						</MudStack>
					</MudPaper>
				</MudItem>
			</MudGrid>
		</MudStack>
	</MudContainer>
</MudPaper>

<MudPaper Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent py-15">
	<MudContainer MaxWidth="MaxWidth.Large">
		<MudGrid Justify="Justify.Center" Spacing="0">
			<MudItem xs="12" sm="6" Class="d-flex align-center">
				<MudPaper Elevation="0" Outlined="false" Class="shades transparent px-6">
					<MudText Color="Color.Secondary" Typo="Typo.overline" Align="Align.Start">TANPA ANTRE PANJANG</MudText>
					<MudText Typo="Typo.h4" Align="Align.Start"><b>Check-in cepat</b></MudText>
					<MudText Typo="Typo.body2" Align="Align.Start" Class="py-4">Lupakan daftar hadir manual. Pindai QR pada e-tiket untuk check-in instan, dan pantau jumlah kehadiran secara real-time.</MudText>
					<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Start" Spacing="2">
						<MudStack Row="true" Spacing="2">
							<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Secondary" Size="Size.Small" />
							<MudText Typo="Typo.body2" Align="Align.Start">E-tiket dengan QR code</MudText>
						</MudStack>
						<MudStack Row="true" Spacing="2">
							<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Secondary" Size="Size.Small" />
							<MudText Typo="Typo.body2" Align="Align.Start">Check-in cepat</MudText>
						</MudStack>
						<MudStack Row="true" Spacing="2">
							<MudHidden Breakpoint="Breakpoint.Xs">
								<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Secondary" Size="Size.Small" />
								<MudText Typo="Typo.body2" Align="Align.Start">Pantau kehadiran</MudText>
							</MudHidden>
							<MudHidden Breakpoint="Breakpoint.SmAndUp">
								<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Secondary" Size="Size.Small" />
								<MudText Typo="Typo.body2" Align="Align.Start" Class="pb-4">Pantau kehadiran</MudText>
							</MudHidden>
						</MudStack>
					</MudStack>
				</MudPaper>
			</MudItem>
			<MudItem xs="12" sm="6" Class="d-flex align-center">
				<MudPaper Elevation="0" Outlined="true" Width="100%" Class="rounded-lg pa-4" Style="background-color: rgba(var(--mud-palette-secondary-rgb), 0.1)">
					<MudStack Row="false" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="0">
						<MudPaper Elevation="0" Outlined="false" Class="shades transparent" MaxWidth="250px">
							<MudImage ObjectFit="ObjectFit.Fill" Src="scanQR-animation.webp" Elevation="0" Class="rounded-lg" Fluid="true" />
						</MudPaper>
					</MudStack>
				</MudPaper>
			</MudItem>
		</MudGrid>
	</MudContainer>
</MudPaper>

<MudPaper Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent py-15">
	<MudContainer MaxWidth="MaxWidth.Large">
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
			<MudText Color="Color.Primary" Typo="Typo.overline" Align="Align.Center">COCOK UNTUK</MudText>
			<MudText Typo="Typo.h4" Align="Align.Center" Class="pb-8"><b>Cocok untuk berbagai jenis acara</b></MudText>
			<MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="true" Style="pointer-events: none">
				<MudChip Selected="true" Variant="Variant.Filled" Color="Color.Primary">Konser dan musik</MudChip>
				<MudChip Selected="true" Variant="Variant.Filled" Color="Color.Primary">Seminar dan konferensi</MudChip>
				<MudChip Selected="true" Variant="Variant.Filled" Color="Color.Primary">Workshop</MudChip>
				<MudChip Selected="true" Variant="Variant.Filled" Color="Color.Primary">Meet up komunitas</MudChip>
				<MudChip Selected="true" Variant="Variant.Filled" Color="Color.Primary">Pameran</MudChip>
				<MudChip Selected="true" Variant="Variant.Filled" Color="Color.Primary">Kelas offline</MudChip>
			</MudChipSet>
		</MudStack>
	</MudContainer>
</MudPaper>

<MudPaper Width="100%" Square="true" Outlined="false" Elevation="0" Class="shades transparent py-15">
	<MudContainer MaxWidth="MaxWidth.Medium">
		<MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
			<MudText id="faq" Color="Color.Secondary" Typo="Typo.overline" Align="Align.Center">PERTANYAAN POPULER</MudText>
			<MudText Typo="Typo.h4" Align="Align.Center" Class="pb-8"><b>Pertanyaan yang sering ditanyakan</b></MudText>
			<MudExpansionPanels Elevation="0" Style="width: 100%">
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Bagaimana peserta melakukan pembayaran tiket ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Setelah mengisi form dan menekan kirim, peserta langsung diarahkan ke halaman pembayaran.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Metode Pembayaran apa saja yang bisa digunakan ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Pembayaran yang bisa digunakan sangat banyak, peserta bebas memilih mau menggunakan yang mana seperti pembayaran QRIS, VA atau E-Wallet.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Bisakah saldo dicairkan dengan cepat ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Sangat bisa, anda cukup memasukkan nomer rekening bank anda lalu menekan tombol cairkan, saldo akan otomatis masuk ke rekening anda.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Bagaimana peserta menerima tiketnya ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Setelah membayar, peserta langsung menerima e-tiket ber-QR code melalui email secara otomatis.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Bagaimana proses check-in di acara ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Anda cukup memindai QR code pada e-tiket peserta untuk melakukan check-in dengan cepat.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Bisakah isi tiket disesuaikan ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Bisa. Anda dapat memberi isi pesan apapun di e-tiket sesuai aturan, brand dan tema acara anda.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
				<MudExpansionPanel MaxHeight="200">
					<TitleContent>
						<MudText><b>Apakah kuota tiket bisa dibatasi ?</b></MudText>
					</TitleContent>
					<ChildContent>
						<MudText Align="Align.Start" Typo="Typo.body2">
							Ya. Anda dapat menentukan kuota dan mengatur periode penjualan tiket.
						</MudText>
					</ChildContent>
				</MudExpansionPanel>
			</MudExpansionPanels>
		</MudStack>
	</MudContainer>
</MudPaper>

<MudScrollToTop>
	<MudFab Size="Size.Small" IconSize="Size.Large" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" />
</MudScrollToTop>


@code {
	[Inject] private NavigationManager _navigation { get; set; } = null!;

	private void NavigateToEvents() => _navigation.NavigateTo("/events");
}