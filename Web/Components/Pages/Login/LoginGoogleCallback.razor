@page "/google-login/callback"
@layout DashboardLayout
@using Blazored.LocalStorage
@inject IHttpClientFactory HttpClientFactory
@inject ILocalStorageService LocalStorageService
@inject IApplicationNavigation AppNav

<MudOverlay Visible="true" DarkBackground="true" Style="height: 100dvh" Absolute="true" ZIndex="5000">
	<MudProgressCircular Color="Color.Primary" Indeterminate="true" />
</MudOverlay>


@code {
	[Parameter]
	[SupplyParameterFromQuery(Name = "key")]
	public string? Key { get; set; }
	[Parameter]
	[SupplyParameterFromQuery(Name = "returnUrl")]
	public string? ReturnUrl { get; set; }

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
			return;

		if (Key is null || ReturnUrl is null)
		{
			AppNav.NavigateToPage();
			return;
		}
		await Task.Delay(1000);

		HttpClient client = HttpClientFactory.CreateClient("backend");
		using (HttpResponseMessage response = await client.PostAsync($"/api/google-login/key-exchange?key={Key}", null))
		{
			if (response.StatusCode != System.Net.HttpStatusCode.OK)
			{
				AppNav.NavigateToUrl(ReturnUrl);
				return;
			}

			KeyExchangeResponse? keyExchangeResponse = await response.Content.ReadFromJsonAsync<KeyExchangeResponse>();
			await LocalStorageService.SetItemAsStringAsync("jwt", keyExchangeResponse!.JsonWebToken);
			await LocalStorageService.SetItemAsStringAsync("refreshToken", keyExchangeResponse!.RefreshToken);
			await LocalStorageService.SetItemAsStringAsync("profileImageUrl", keyExchangeResponse!.ProfileImageUrl);

			AppNav.NavigateToUrl(ReturnUrl);
		}
	}

	#region support record or class
	public record KeyExchangeResponse(string JsonWebToken, string RefreshToken, string ProfileImageUrl);
	#endregion
}